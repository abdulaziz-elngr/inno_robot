# ── Public URL ────────────────────────────────────────────────────────────────
# Canonical base URL of the deployment (used for links, CSRF origin checks, password-reset links).
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# ── PostgreSQL (Neon) ─────────────────────────────────────────────────────────
# Pooled endpoint (pgbouncer) — used at runtime:
DATABASE_URL=
# Direct endpoint — used by migrations (npm run db:migrate):
DIRECT_URL=
DATABASE_POOL_MAX=10
# Set to "disable" only for a local Postgres without TLS.
# DATABASE_SSL=
# Local development with no Postgres falls back to an embedded PGlite database in .data/.
# Set ALLOW_EMBEDDED_DB=1 only to run a production build locally without Neon.
ALLOW_EMBEDDED_DB=

# ── Authentication ────────────────────────────────────────────────────────────
# Random 32+ character secret, e.g.  openssl rand -base64 48
AUTH_SECRET=
# Session lifetime in hours (default 720 = 30 days)
SESSION_HOURS=

# ── AI provider (server-side only, never exposed to the browser) ──────────────
# Any OpenAI-compatible endpoint works (OpenAI, Azure OpenAI, OpenRouter, Groq, ...).
# When AI_API_KEY is empty the assistant clearly reports "AI not configured".
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MAX_CONTEXT_MESSAGES=12
AI_REQUEST_TIMEOUT_MS=15000
AI_MAX_TOKENS=600
# Abuse prevention: assistant requests allowed per IP per calendar day.
AI_DAILY_LIMIT_PER_IP=60

# ── Cloudinary (media) ────────────────────────────────────────────────────────
# When empty, admin uploads are refused with a clear "Cloudinary not configured" state.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional upload folder prefix
CLOUDINARY_FOLDER=

# ── Device (ESP32) authentication ─────────────────────────────────────────────
# HMAC secret used to sign device API requests (X-Device-Signature).
# Generate with:  openssl rand -hex 32
DEVICE_AUTH_SECRET=

# ── Misc ──────────────────────────────────────────────────────────────────────
# Simulator label shown in the UI when robot data is simulated (do not change in production).
# SIMULATION_LABEL=SIMULATED
